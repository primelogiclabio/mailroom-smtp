<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.primelogiclab.mailroom</groupId>
        <artifactId>mailroom-smtp-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>mailroom-smtp</artifactId>
    <name>mailroom-smtp</name>
    <description>SMTP transport for mailroom on Jakarta Mail and Angus Mail. Java 21 set.</description>

    <properties>
        <module.name>io.primelogiclab.mailroom.smtp</module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.primelogiclab.mailroom</groupId>
            <artifactId>mailroom-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.mail</groupId>
            <artifactId>jakarta.mail-api</artifactId>
        </dependency>
        <!-- Compile scope, not runtime: SMTP replies are read from org.eclipse.angus.mail.smtp's exceptions. -->
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>io.primelogiclab.mailroom</groupId>
            <artifactId>mailroom-tck</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Adds shared-tests, the tests and fixtures this module shares with its Java 8 twin. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
